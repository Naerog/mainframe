000042         PROCEDURE DIVISION.
000043
000044         0000-PRINCIPAL.
000045             PERFORM 1000-INICIALIZAR
000046                THRU 1000-FIM-INICIALIZAR
000047
000048             PERFORM 2000-PROCESSAR
000049                THRU 2000-FIM-PROCESSAR
000050                UNTIL WS-FS-ENTRADA-FIM
000051
000052             PERFORM 3000-FINALIZAR
000053                THRU 3000-FIM-FINALIZAR
000054
000055             STOP RUN
000056             .
000057
000058         1000-INICIALIZAR.
000059             OPEN INPUT ARQ-DIVERG
000060
