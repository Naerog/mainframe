000171                     SET RJ-VALOR-INVALIDO    TO TRUE
000172                     MOVE 'VALOR ZERADO'
000173                                              TO RJ-DESC-MOTIVO
000174                WHEN TR-DATA-TRANSACAO IS NOT NUMERIC
000175                WHEN NOT WS-MES-VALIDO
000176                WHEN NOT WS-DIA-VALIDO
000177                     SET WS-REGISTRO-INVALIDO TO TRUE
000178                     SET RJ-DATA-INVALIDA TO TRUE
000179                     MOVE 'DATA INVALIDA' TO RJ-DESC-MOTIVO
000180
000181                WHEN TR-NEGADA
000182                     SET WS-REGISTRO-INVALIDO TO TRUE
000183                     SET RJ-TRANSACAO-NEGADA TO TRUE
000184                     MOVE 'TRANSACAO NEGADA' TO RJ-DESC-MOTIVO
000185             END-EVALUATE.
